  ]
}

### HT-7. Compact lan dau. Summary phai giu: tam anh co dong ho lam ngoai pham, tran bong tren TV,
# nhieu anh chup nha Chris va Danie. Khong duoc them chi tiet khong co trong ban ghi.
POST {{RAG_HostAddress}}/api/query/compact-history
Content-Type: application/json

{
  "npcName": "Johny",
  "history": [
    { "role": "player", "content": "Chào ông Johny." },
    { "role": "npc", "content": "Chào. Có chuyện gì?" },
    { "role": "player", "content": "Lúc xảy ra vụ án ông ở đâu?" },
    { "role": "npc", "content": "Tôi ở nhà. Tôi có tấm ảnh chụp cùng đồng hồ, giờ trên đó trước lúc xảy ra vụ án 2 phút." },
    { "role": "player", "content": "Trong tấm ảnh còn có gì nữa?" },
    { "role": "npc", "content": "Chỉ có cái TV đang chiếu trận bóng thôi." },
    { "role": "player", "content": "Sao ông có nhiều ảnh chụp nhà Chris và Danie thế?" },
    { "role": "npc", "content": "Tôi thích chụp ảnh khu phố, vậy thôi." }
  ]
}

### HT-8. Compact noi tiep: summary moi phai GIU noi dung cua previousSummary VA them doi gang tay.
# Da tung lam roi noi dung cu khi tom tat cu duoc dung chung voi ban ghi.
POST {{RAG_HostAddress}}/api/query/compact-history
Content-Type: application/json

{
  "npcName": "Johny",
  "previousSummary": "Johny khai lúc xảy ra vụ án ông ở nhà, đưa ra tấm ảnh chụp cùng đồng hồ chỉ trước thời điểm vụ án 2 phút làm bằng chứng ngoại phạm; trong ảnh có TV đang chiếu trận bóng. Khi bị hỏi vì sao có nhiều ảnh chụp nhà Chris và Danie, Johny nói chỉ thích chụp ảnh khu phố.",
  "history": [
    { "role": "player", "content": "Đôi găng tay trên bàn kia là của ai?" },
    { "role": "npc", "content": "Của tôi. Có gì lạ đâu." }
  ]
}

