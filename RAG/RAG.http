########################################################################################
# CACHE CAU TRA LOI THEO NGU NGHIA (Faiss / Redis) DA DUOC GO HAN KHOI DU AN.
# Cac bai C1-C10 cu nam trong lich su git. Cac cache con lai (chuan hoa, embedding, route)
# van dung: xem GET api/query/cache-stats.
########################################################################################

########################################################################################
# ASK-STREAM (SSE) — tra loi tung manh
#
# CANH BAO: REST Client cua VS Code GOM ca luong roi moi hien, nen BAM RUN O DAY KHONG
#    CHUNG MINH DUOC STREAMING. No chi dung de kiem hinh dang phan hoi. Muon chung minh
#    tung manh that su toi noi thi phai dung `curl -N` (xem khoi CHUNG MINH ben duoi).
#
# Chuoi su kien:  meta -> token* -> done | error
#   event: meta    data: {"weakPointHit":false}         <- LUON la su kien dau tien
#   event: token   data: {"text":"..."}                 <- noi vao cuoi; co the 0 hoac nhieu
#   event: done    data: {}                             <- ket thuc binh thuong
#   event: error   data: {"status":429,"title":"..."}   <- loi SAU khi luong da bat dau
#
# Hai truong hop client PHAI chiu duoc:
#   - 1 token nguyen cuc  (route co loi dap co dinh, khong qua LLM)
#   - error den SAU vai token
#
# Loi TRUOC khi luong bat dau van la ProblemDetails voi ma dung (400/429/503/500), y het
# `ask` — endpoint nay khong lam yeu di ngu nghia ma loi.
########################################################################################

### S1. NHANH RAG: stream that, nhieu token
POST {{RAG_HostAddress}}/api/query/ask-stream
Content-Type: application/json
Accept: text/event-stream

{ "npcName": "Wills", "npcSystem": "cộc cằn, hay phàn nàn", "Question": "ông mô tả kỹ giúp tôi hiện trường vụ án trông như thế nào" }

### S2. NHANH ROUTE (tan gau): stream that
POST {{RAG_HostAddress}}/api/query/ask-stream
Content-Type: application/json
Accept: text/event-stream

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "xin chào bạn khỏe không" }

### S5. RANH GIOI LOI TRUOC-FLUSH: body rong phai ra 400 ProblemDetails, KHONG phai 200 SSE
POST {{RAG_HostAddress}}/api/query/ask-stream
Content-Type: application/json

{}

########################################################################################
# CHUNG MINH STREAM TOI TUNG MANH (khong lam duoc bang REST Client)
#
#   curl -N -s -X POST http://localhost:5263/api/query/ask-stream \
#     -H "Content-Type: application/json" --data-binary @cauhoi.json \
#   | while IFS= read -r line; do printf "%s  %s\n" "$(date +%H:%M:%S.%3N)" "$line"; done
#
# `-N` (--no-buffer) la BAT BUOC — thieu no thi chinh curl dem lai va ban se ket luan nham
# la server hong.
#
# TIEU CHI DAT: moc thoi gian cua cac dong `event: token` LIEN TIEP phai cach nhau hang
# chuc den hang tram ms. Neu tat ca cung mot moc mili-giay thi dang co cho dem — kiem theo
# dung thu tu nay:
#   1. FlushAsync sau MOI su kien                  (AskStreamSseResult.WriteEventAsync)
#   2. DisableBuffering()                          (AskStreamSseResult.StartStream)
#   3. HttpCompletionOption.ResponseHeadersRead    (GeminiLLMProvider.TryOpenStreamAsync)
#
# KIEM ENCODING (cau tra loi la tieng Viet co dau):
#   curl -N -s ... | grep "^data:" | head -5   -> phai thay chu Viet THO, khong phai \uXXXX
#   curl -N -s ... | head -c 3 | xxd           -> KHONG duoc la  ef bb bf  (BOM)
#
# KIEM DONG DO TRE (log muc Information):
#   Độ trễ [askStream] ... branch=retrieval | ... | llmFirstToken=731.2ms | llmAnswer=1131.3ms
#   - thieu llmFirstToken             -> luong khong sinh token nao (route co loi dap co dinh
#                                        thi binh thuong, vi khong qua LLM)
#   - total ~ 0ms, khong stage nao    -> phien do chet truoc luong: TimedAskStreamService
#                                        khong phai iterator, hoac thieu
#                                        [EnumeratorCancellation], hoac thieu
#                                        session.Activate() sau yield return
#   - branch=retrieval cho cau chao hoi -> AskBranchResolver bi goi ngoai finally
#
# NGAT GIUA CHUNG:
#   Chay curl -N roi Ctrl-C sau ~3 token. Log phai co "Client ngắt kết nối giữa luồng SSE."
#   VA mot dong Độ trễ [askStream] co llmAnswer ngan hon binh thuong.
########################################################################################

########################################################################################
# CLIENT UNITY (C#) — doc SSE
#
# CANH BAO: UnityWebRequest KHONG doc stream tung manh duoc — no gom ca body roi moi goi
#    callback. Phai dung System.Net.Http.HttpClient.
#
#   using var client  = new HttpClient { Timeout = Timeout.InfiniteTimeSpan };
#   using var request = new HttpRequestMessage(HttpMethod.Post, url) { Content = ... };
#
#   using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, ct);
#   response.EnsureSuccessStatusCode();     // 400/429/503 -> ProblemDetails, xu ly nhu `ask`
#
#   await using var body = await response.Content.ReadAsStreamAsync(ct);
#   using var reader = new StreamReader(body, Encoding.UTF8);
#
#   string eventName = null;
#   while (await reader.ReadLineAsync() is { } line)
#   {
#       if (line.Length == 0) continue;                 // ranh gioi giua hai khung
#       if (line[0] == ':') continue;                   // dong chu thich, bo qua
#       if (line.StartsWith("event: ")) { eventName = line[7..]; continue; }
#       if (!line.StartsWith("data: ")) continue;
#
#       var json = line[6..];
#       switch (eventName)
#       {
#           case "meta":  /* doc weakPointHit; bat nhip kich ban neu true */ break;
#           case "token": /* noi text vao TextMeshPro */                     break;
#           case "error": /* hien thong bao loi, dung */                     break;
#           case "done":  return;
#       }
#   }
#
# ResponseHeadersRead o phia client cung BAT BUOC, cung ly do voi phia server: thieu no thi
# HttpClient dem het body roi moi tra ve, va ban co mot stream nhin giong mot cuc.
########################################################################################

###
########################################################################################
# KHOI N - NAP CORPUS VAO QDRANT.
#
# Payload npcNames mang TEN RIENG ("Edward"), doi tu vai tro trong corpus ("Phap y") qua
# bi_danh cua graphrag/entities.json. Id diem = SHA256(chunkCode), nen nap lai la GHI DE
# dung 45 diem cu, khong can xoa collection.
########################################################################################

### N-0. Xem truoc bang phan quyen, KHONG ghi gi. Cot NPC phai la ten rieng.
GET {{RAG_HostAddress}}/api/query/corpus-access
Accept: application/json

### N-1. Tao collection + payload index. CHI can khi collection chua ton tai.
POST {{RAG_HostAddress}}/api/query/create-collection
Accept: application/json

### N-2. Nap ca thu muc corpus. Phai ra 11 file / 45 chunk / 13 NPC.
POST {{RAG_HostAddress}}/api/query/ingest-corpus
Accept: application/json

###
########################################################################################
# KHOI G - DO THI TRI THUC (GraphRAG).
#
# G-0/G-1/G-2 (indexes, load, verify) chi song khi CA HAI co bat VA o Development:
#   Graph:Enabled        = true
#   Graph:Loader:Enabled = true
# Thieu mot trong hai thi ba request do tra 404 - co y nhu vay: nap do thi la thao tac ghi
# de du lieu. TAT Loader:Enabled lai ngay sau khi nap xong.
#
# G-3 tro xuong chi can Graph:Enabled = true - chay duoc ca khi Loader da tat.
#
# npcName la TEN RIENG cua NPC ("Edward", "James"...), giong moi endpoint khac. Vai tro
# trong corpus ("Phap y") duoc doi sang ten rieng qua bi_danh cua entities.json luc nap.
########################################################################################

### G-0. Tao constraint + index. Chay MOT LAN truoc lan nap dau tien.
# MERGE khong co constraint co the de ra ban trung, va Neo4j TU CHOI them constraint sau
# khi da co trung - nen thu tu nay khong doi duoc.
POST {{RAG_HostAddress}}/api/graph/indexes
Accept: application/json

### G-1. Nap do thi tu graphrag/*.json. MERGE-only, chay lai bao nhieu lan cung mot ket qua.
# Toan bo 118 node + 185 canh + 13 ACL nam trong MOT giao dich: hoac vao het, hoac khong
# gi ca. Hong giua chung thi khong de lai trang thai nua voi.
POST {{RAG_HostAddress}}/api/graph/load
Accept: application/json

### G-2. Doi chieu DB voi file nguon.
# Phai ra: entities 118, npcs 13, relationships 185, expectedRelationships 185, matches true.
# matches=false KHONG phai loi: MERGE khong xoa, nen mot canh da go khoi file van con trong
# DB cho toi khi co nguoi xoa tay.
GET {{RAG_HostAddress}}/api/graph/verify
Accept: application/json

### G-3. So lieu tang do thi (chay duoc ca khi do thi dang tat - luc do toan so 0).
GET {{RAG_HostAddress}}/api/graph/stats
Accept: application/json

### G-4. Local search. Ton MOT luot LLM trich thuc the, khong ton luot sinh cau tra loi.
# Hat giong la thuc the LLM chon trong danh muc NPC duoc biet (xem G-11), khong con nhap ma chunk.
# Phai ra: extraction.entities co "Chris", extraction.relationTypes co CO_DAU_VET_CAM, va canh
# Chris ... Khau sung nam trong nhung dong dau.
# Gemini chay temperature 0.5: hai lan goi co the chon hat giong khac nhau.
POST {{RAG_HostAddress}}/api/graph/local-search-debug
Content-Type: application/json

{
  "npcName": "Edward",
  "question": "tay của Chris có dấu vết gì không",
  "limit": 16
}

### G-5. RO QUYEN - bai test khong duoc bo.
# Cung cau hoi, hoi bang Jack. Jack KHONG doc duoc ho so phap y. Ket qua phai KHONG chua mot
# ma chunk nao bat dau bang "25_phap-y", ke ca tren node lan can. Trung mot cai la ACL hong ->
# dung moi thu lai.
POST {{RAG_HostAddress}}/api/graph/local-search-debug
Content-Type: application/json

{
  "npcName": "Jack",
  "question": "tay của Chris có dấu vết gì không",
  "limit": 16
}

### G-6. Ten la: "con meo" khong co trong do thi.
# Phai ra: ten la bi bo khoi extraction.entities, KHONG loi, degraded = false.
POST {{RAG_HostAddress}}/api/graph/local-search-debug
Content-Type: application/json

{
  "npcName": "Edward",
  "question": "con mèo của Chris tên là gì",
  "limit": 16
