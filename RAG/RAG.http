# ==========================================================================
# ROUTER LLM - chien luoc SemanticRouter:Strategy = Llm (mac dinh)
# LLM doc cau hoi va chon dung mot nhan; khong dung vector nao.
# Ket qua da chay that: 9/9 ca duoi day dung.
# ==========================================================================

### LLM route: chao hoi (ky vong chitchat, score = null)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "xin chào ông" }

