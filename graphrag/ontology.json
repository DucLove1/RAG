{
  "phien_ban": "3.0.0",
  "mo_ta": "Tu vung cua do thi tri thuc vu an Chris-Danie, rut tu 45 dong trong corpus/. NGUON SU THAT DUY NHAT cua ten nhan, ten loai quan he va gia tri trang_thai: code C# khong duoc chua mot chuoi nao trong so nay - chung di vao Cypher duoi dang THAM SO.",
  "nhan": [
    {
      "ten": "ThucThe",
      "goc": true,
      "mo_ta": "Nhan nen tren MOI node. Truy van mo rong bat dau tu day, nen them mot loai thuc the moi khong phai sua Cypher."
    },
    {
      "ten": "NhanVat",
      "npc": true,
      "mo_ta": "NPC nguoi choi thau van duoc. Day la nhan THU HAI dat tren chinh node :Nguoi tuong ung, khong phai mot node rieng. Chi node mang nhan nay moi co thuoc tinh duoc_biet."
    },
    {
      "ten": "Nguoi",
      "mo_ta": "Mot ca nhan trong cau chuyen."
    },
    {
      "ten": "Nhom",
      "mo_ta": "Mot tap nguoi duoc nhac toi nhu mot the: cap doi, gia dinh, dam dong khu pho, to canh sat."
    },
    {
      "ten": "SuKien",
      "mo_ta": "Mot chuyen da xay ra."
    },
    {
      "ten": "VatChung",
      "mo_ta": "Mot vat the mang thong tin ve vu an."
    },
    {
      "ten": "DiaDiem",
      "mo_ta": "Mot noi chon."
    },
    {
      "ten": "ThoiGian",
      "mo_ta": "Mot moc hoac khoang thoi gian; thuoc_tinh thu_tu cho phep dung dong thoi gian."
    },
    {
      "ten": "DacDiem",
      "mo_ta": "Mot dac diem hoac dau vet quan sat duoc tren nguoi hoac vat."
    },
    {
      "ten": "NhanDinh",
      "mo_ta": "Mot phat bieu cua ai do, KHONG phai su that. Mang nguoi_khai va do_tin_cay, nho do loi khai sai van o lai trong do thi ma khong duoc doc nhu ket luan."
    },
    {
      "ten": "GiaThuyet",
      "mo_ta": "Mot loi giai thich kha di cho vu an; diem quy tu cua UNG_HO va MAU_THUAN. Do thi KHONG danh dau gia thuyet nao dung - do la viec cua nguoi choi."
    }
  ],
