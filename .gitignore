## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Visual Studio User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache & settings
.vs/
# Cache vector cua semantic router: du lieu sinh ra tu appsettings.json, khong phai source.
# Commit vao se tao diff vo nghia va cu ngay khi ai do sua cau mau.
App_Data/
route-vectors.json

# Benchmark dinh tuyen: bo cau hoi va script chay/bao cao chi dung o may dev.
# KHONG ignore code C# hay Config/route-benchmark.json: code da commit tham chieu toi chung, va
# options RouteBenchmark duoc validate luc khoi dong ([Required]/[MinLength]) nen thieu file la
# app khong len. Ket qua chay nam o App_Data/benchmark, von da bi ignore o tren.
RAG/Benchmark/
scripts/
