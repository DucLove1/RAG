# ==========================================================================
# GUARDRAIL: cau ngoai the gioi game (route out_of_scope)
# NPC phai giu vai, khong duoc tra loi
# ==========================================================================

### PHAI KHOP out_of_scope: hoi ve he thong
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Wills", "npcSystem": "cộc cằn, hay phàn nàn", "Question": "bạn là AI phải không" }

### PHAI KHOP out_of_scope: yeu cau tac vu ngoai game
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Wills", "npcSystem": "cộc cằn, hay phàn nàn", "Question": "viết code python cho tôi" }

### PHAI DI RAG: mua la chi tiet vu an, khong phai hoi thoi tiet that
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Wills", "npcSystem": "cộc cằn, hay phàn nàn", "Question": "tối hôm đó trời có mưa không" }

###
# ==========================================================================
# THEM CAU MAU LUC CHAY - co hieu luc ngay, khong can khoi dong lai
# ==========================================================================

### Them cau dang text (se duoc nhung tu dong)
POST {{RAG_HostAddress}}/api/query/route-utterances
Content-Type: application/json

{
  "route": "out_of_scope",
  "utterances": [ "cách nấu phở bò", "công thức làm bánh mì" ]
}

### Them vector da chuan bi san (phai dung 768 chieu, khac vector 0)
POST {{RAG_HostAddress}}/api/query/route-utterances
Content-Type: application/json

{
  "route": "chitchat",
  "vectors": [ [ 0.012, -0.034, 0.056 ] ]
}

### Gui ca hai cung luc
POST {{RAG_HostAddress}}/api/query/route-utterances
Content-Type: application/json

{
  "route": "thanks",
  "utterances": [ "ơn ông nhiều" ],
  "vectors": []
}

### Route sai ten -> 400 kem danh sach route hien co
POST {{RAG_HostAddress}}/api/query/route-utterances
Content-Type: application/json

{ "route": "khong_ton_tai", "utterances": [ "abc" ] }

