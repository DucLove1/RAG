@RAG_HostAddress = http://localhost:5263

# ==========================================================================
# LUU Y HINH DANG PHAN HOI (thay doi co the pha client):
# POST api/query/ask tra ve OBJECT chu khong con la chuoi tran:
#   { "answer": "...", "weakPointHit": false }
# Moi vi du "ask" ben duoi deu tra ve dang nay.
#
# POST api/query/ask-stream la endpoint RIENG tra ve Server-Sent Events tung manh.
# `ask` KHONG doi gi — xem khoi ASK-STREAM o cuoi file.
# ==========================================================================

### Health check
GET {{RAG_HostAddress}}/api/query/check-health
Accept: application/json

###
# ==========================================================================
# CHAN DOAN DINH TUYEN.
# LUU Y: voi SemanticRouter:Strategy = Llm / Jev thi endpoint nay CO goi model
# (mot luot phan loai moi request). Van khong cham Qdrant va van re hon nhieu so
# voi chay ca duong tra loi. Co tinh KHONG di qua cache dinh tuyen, de ket qua
# luon phan anh prompt / cau hoi Choice hien tai.
# Truong "strategy" trong phan hoi cho biet chien luoc nao da quyet dinh;
# "score" la null voi chien luoc Llm vi no chon nhan chu khong cham diem;
# voi Jev, "score" la XAC SUAT cua tung route va "threshold" la Jev:MinProbability.
# ==========================================================================

### Route debug: cau chao hoi (ky vong khop chitchat)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "xin chào bạn" }

### Route debug: sai chinh ta, khong dau (ky vong khop chitchat sau khi chuan hoa)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "chao bn oi, dao nay ntn" }

### Route debug: cau hoi tri thuc (ky vong KHONG route nao khop)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "cửa hàng của bạn bán những loại thuốc gì" }

### Route debug: cau pha tron y dinh (ky vong KHONG khop)
# Voi Strategy=Embedding: bi MaxRoutableLength chan truoc khi cham diem.
# Voi Strategy=Llm:       phai do LUAT TRONG PROMPT chan ("vua chao vua hoi -> truy_van_tri_thuc").
# Voi Strategy=Jev:       phai do Jev:Instructions + Jev:NoMatchDescription chan.
# Day la ca dang gia nhat: cosine khong doc hieu duoc, LLM thi doc duoc.
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "chào bạn, cho tôi hỏi giá của kiếm sắt là bao nhiêu" }

