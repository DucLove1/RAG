@RAG_HostAddress = http://localhost:5263

### Health check
GET {{RAG_HostAddress}}/api/query/check-health
Accept: application/json

###
# ==========================================================================
# CHAN DOAN DINH TUYEN.
# LUU Y: voi SemanticRouter:Strategy = Llm thi endpoint nay CO goi LLM (mot
# luot phan loai moi request). Van khong cham Qdrant va van re hon nhieu so voi
# chay ca duong tra loi. Co tinh KHONG di qua cache dinh tuyen, de ket qua luon
# phan anh prompt hien tai.
# Truong "strategy" trong phan hoi cho biet chien luoc nao da quyet dinh;
# "score" la null voi chien luoc Llm vi no chon nhan chu khong cham diem.
# ==========================================================================

### Route debug: cau chao hoi (ky vong khop chitchat)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "xin chào bạn" }

### Route debug: sai chinh ta, khong dau (ky vong khop chitchat sau khi chuan hoa)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "chao bn oi, dao nay ntn" }

### Route debug: cau hoi tri thuc (ky vong KHONG route nao khop)
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "cửa hàng của bạn bán những loại thuốc gì" }

### Route debug: cau pha tron y dinh (ky vong KHONG khop)
# Voi Strategy=Embedding: bi MaxRoutableLength chan truoc khi cham diem.
# Voi Strategy=Llm:       phai do LUAT TRONG PROMPT chan ("vua chao vua hoi -> khong_khop").
# Day la ca dang gia nhat: cosine khong doc hieu duoc, LLM thi doc duoc.
POST {{RAG_HostAddress}}/api/query/route-debug
Content-Type: application/json

{ "Question": "chào bạn, cho tôi hỏi giá của kiếm sắt là bao nhiêu" }

###
# ==========================================================================
# END-TO-END. Kiem tra bang log Grpc.Net.Client:
#   - Request thoat som  -> 0 dong "Starting gRPC call"
#   - Request di RAG     -> it nhat 2 dong
# ==========================================================================

### PHAI THOAT SOM: chao hoi
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "xin chào bạn" }

### PHAI THOAT SOM: sai chinh ta, khong dau
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "chao bn oi, dao nay ntn" }

### PHAI THOAT SOM: cam on
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "cam on ban nhieu nhe" }

### PHAI THOAT SOM: tam biet
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "thôi tôi đi đây" }

### PHAI DI RAG: cau hoi tri thuc
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "cửa hàng của bạn bán những loại thuốc gì" }

### RANH GIOI - phai di RAG du mo dau bang loi chao
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "chào bạn, cho tôi hỏi giá của kiếm sắt là bao nhiêu" }

### RANH GIOI - phai di RAG (gan "ban khoe khong" ve mat ngu nghia)
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "bạn có bán thuốc hồi máu không" }

