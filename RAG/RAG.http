# ==========================================================================
# HOI THOAI - lich su do CLIENT giu, server khong luu phien.
# ask / ask-stream nhan them "summary" va "history" (TUY CHON). Bo trong ca hai thi
# hanh vi y het truoc. Khi co lich su:
#   - buoc chuan hoa VIET LAI cau noi tiep thanh cau doc lap (xem log "Chuan hoa cau hoi")
#   - cache chuan hoa BI BO QUA
# compact-history gop doan lich su thanh MOT chuoi summary; client tu quyet khi nao goi.
#
# Moi vi du bam dung corpus/: NPC chi tra loi duoc tu tai lieu co "nguon" la chinh NPC do.
#   Wills (20_wills): nghe 2 tieng sung cach nhau 15 phut; cho rang Chris la ga ban trai toi te, bao luc.
#   Jack  (26_jack) : ban than ca Chris lan Danie, mo tiem sua xe; toi hom TRUOC an mang den nha
#                     ho tham va sua xe, thay ho van hoa thuan; khong tin ho tu sat.
#   Johny (23_johny): khai o nha, dua tam anh chup cung dong ho (truoc vu an 2 phut) lam ngoai pham,
#                     trong anh co tran bong dang chieu; co nhieu anh chup nha Chris va Danie,
#                     anh chup chiec xe dau truoc nha, va mot doi gang tay tren ban.
# ==========================================================================

### HT-1. Cau noi tiep: "han" phai duoc viet lai thanh "Chris".
# Ky vong log: "... -> Ông nghĩ Chris có phải là người bạo lực không?"
# Ky vong cau tra loi: Wills cho rang Chris la ga ban trai toi te va bao luc.
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{
  "npcName": "Wills", "npcSystem": "cộc cằn, hay phàn nàn",
  "question": "ông nghĩ hắn có phải người bạo lực không?",
  "history": [
    { "role": "player", "content": "Ông có biết Chris, người sống ở căn nhà xảy ra án mạng không?" },
    { "role": "npc", "content": "Biết chứ, cái gã sống chung với Danie ở căn nhà đó." }
  ]
}

