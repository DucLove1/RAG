{
  "LLM": {
    "Provider": "Groq"
  },
  "GEMINILLM": {
    "Url": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-3.1-flash-lite",
    "InteractionsPath": "interactions",
    "StreamInteractionsPath": "interactions?alt=sse",
    "StreamTimeoutSeconds": 120,
    "Temperature": 0.5,
    "MaxOutputTokens": 400,
    "ThinkingLevel": "Minimal",
    "ServiceUnavailableRetries": 1,
    "ServiceUnavailableRetryDelayMs": 300
  },
  "GROQ": {
    "Model": "openai/gpt-oss-20b",
    "StreamTimeoutSeconds": 120,
    "Temperature": 0.5,
    "MaxOutputTokens": 400,
    "ReasoningEffort": "Medium"
  },
  "EmbeddingModel": {
    "Url": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "models/gemini-embedding-2",
    "EmbedContentPathTemplate": "{0}:embedContent",
    "BatchEmbedContentPathTemplate": "{0}:batchEmbedContents",
    "OutputDimensions": 768,
    "BatchSize": 50,
    "BatchDelaySeconds": 60
  }
}
