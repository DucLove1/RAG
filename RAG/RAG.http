# ==========================================================================
# CHUNG MINH TIET KIEM EMBEDDING - phan thu loi chinh cua thay doi nay.
# Doc khoi "embedding" trong cache-stats truoc va sau moi request.
# Da chay that: cau tan gau = 0, cau tri thuc = 1.
# ==========================================================================

### A. Moc embedding
GET {{RAG_HostAddress}}/api/query/cache-stats
Accept: application/json

### B. Cau tan gau MOI TINH -> hits+misses cua embedding phai tang 0
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "chào ông buổi sáng nhé q1198" }

### C. Cau tri thuc MOI TINH -> tang dung 1
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Lan", "npcSystem": "vui vẻ, thân thiện", "Question": "ông biết gì về cây kiếm sắt q1198" }

### D. Doi chieu
GET {{RAG_HostAddress}}/api/query/cache-stats
Accept: application/json

###
# ==========================================================================
# CHUYEN CHIEN LUOC - khong sua mot dong code nao.
#
#   SemanticRouter__Strategy=Embedding   (bien moi truong hoac appsettings)
#     - Chay lai 5 ca dau: diem quay lai dang SO, strategy = "Embedding"
#     - Warm-up phai nap 160 cau mau tu CACHE, khong goi API embedding
#     - route-utterances duoi day -> HTTP 200
#
#   SemanticRouter__Strategy=Llm
#     - route-utterances duoi day -> HTTP 400 kem message NotSupported
#     - KHONG can key TypeSafe: section TYPESAFE chi duoc validate khi Strategy=Jev
#
#   SemanticRouter__Strategy=Jev   (mac dinh trong Config/semantic-router.json)
#     - route-debug: strategy = "Jev", score la xac suat tung route
#     - route-utterances duoi day -> HTTP 400 kem message NotSupported
#     - Jev loi / qua han TYPESAFE:TimeoutSeconds / 529 -> moi cau di RAG, khong 500
#
#   SemanticRouter__Strategy=Off
#     - Moi cau di RAG, route-debug tra scores rong va strategy = "Off"
#     - route-utterances -> HTTP 400 kem message RouterDisabled
#
# BAY DI TRU: khoi dong voi ten khoa CU (SemanticRouter__VectorCachePath hoac
# SemanticRouter__Enabled) thi app PHAI khong khoi dong duoc, kem thong bao
# chi ro ten moi. Neu no van khoi dong binh thuong thi bay da hong.
# ==========================================================================

### route-utterances: ket qua phu thuoc chien luoc dang chay
POST {{RAG_HostAddress}}/api/query/route-utterances
Content-Type: application/json

{ "Route": "chitchat", "Utterances": ["chào ông lão ơi"] }

###
# ==========================================================================
# NODE DIEM YEU (WeakPoint) DA DUOC GO KHOI PIPELINE (AskPipeline / AskStreamPipeline).
# Cac case 1-9 cu (cau chot, tat node, tiet kiem, dieu kien an toan, stage) nam trong lich su git.
# Phan hoi van con truong weakPointHit de client cu khong vo, nhung luon la false.
# ==========================================================================

### 10. STAGE: loc tri thuc theo tung dong trong corpus (corpus/23_johny.md)
# Luat TICH LUY: o stage n, NPC biet dong khong gan stage + dong gan stage <= n.
# Ky vong: cau tra loi PHAI nhac duoc chuyen Johny "vo tinh chup thu may anh" -
# dong nay gan [stage:2], hien o Stage 2 VA Stage 3 (tich luy), KHONG hien o Stage 1.
POST {{RAG_HostAddress}}/api/query/ask
Content-Type: application/json

{ "npcName": "Johny", "npcSystem": "dè dặt, hay né tránh", "Question": "tấm ảnh chiếc xe màu đỏ trước nhà Chris là sao vậy", "Stage": 2 }

### 11. STAGE: cung cau hoi nhung gui Stage 1 -> dong [stage:2] KHONG duoc dua vao ngu canh
# Ky vong: context-debug (xem khoi GraphAdminController) khong con dong "vo tinh chup thu may anh".
# Doi Stage thanh 3 thi dong do PHAI xuat hien tro lai (tich luy). Dung de doi chieu voi case 10.
POST {{RAG_HostAddress}}/api/graph/context-debug
Content-Type: application/json

{ "npcName": "Johny", "question": "tấm ảnh chiếc xe màu đỏ trước nhà Chris là sao vậy", "Stage": 1 }

### 12. STAGE DO THI: danh muc thuc the cua Johny o stage 1 (luat tich luy: biet stage <= n)
# Ky vong: KHONG co "Tấm ảnh có đồng hồ của Johny", "Tấm ảnh chiếc xe"; CO "Máy ảnh của Johny".
# Khong goi LLM. Doi stage=2 thi them "Tấm ảnh chiếc xe"; stage=3 thi them tam anh co dong ho.
GET {{RAG_HostAddress}}/api/graph/catalog-debug?npcName=Johny&stage=1

### 13. STAGE DO THI: canh quanh Johny o stage 2 (ton MOT luot LLM trich thuc the)
# Ky vong: co canh "vô tình chụp tấm ảnh chiếc xe" (stage 2) va "Thích chụp ảnh" (stage 1, tich luy);
# KHONG co canh nao co ma_chunk 23_johny#L8..L13 (stage 3).
POST {{RAG_HostAddress}}/api/graph/local-search-debug
Content-Type: application/json

